# Postgres (source of truth)
DATABASE_URL=postgres://servitor:servitor@localhost:5432/servitor

# Redis (ephemeral cache; persistence is off in Compose)
REDIS_URL=redis://127.0.0.1:6379

# Redpanda advertised to the host. In-compose clients use redpanda:9092.
KAFKA_BROKERS=localhost:19092

# OTLP (collector). Unused until Phase 6.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# HTTP / gRPC bind (unused until Phases 3 and 5)
SERVITOR_HTTP_ADDR=0.0.0.0:8080
SERVITOR_GRPC_ADDR=0.0.0.0:8081

# Bootstrap API key is created in Phase 3 via CLI or SQL. Do not put real keys here.